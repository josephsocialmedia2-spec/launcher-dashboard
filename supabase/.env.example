# F1 Email Radar — SOLO NOMI VARIABILI, NESSUN SEGRETO
# Configurare questi valori in Supabase Edge Function Secrets, mai in GitHub Pages.

# Discovery
GOOGLE_MAPS_API_KEY=
BRAVE_SEARCH_API_KEY=

# Registro Imprese / InfoCamere: valori dal contratto/API autorizzato
REGISTRO_IMPRESE_API_BASE=
REGISTRO_IMPRESE_SEARCH_PATH=
REGISTRO_IMPRESE_API_KEY=
REGISTRO_IMPRESE_API_KEY_HEADER=
REGISTRO_IMPRESE_HTTP_METHOD=POST

# Mapping contrattuale Registro Imprese / InfoCamere
# Il path e i campi dipendono dal servizio acquistato: non inventare valori.
REGISTRO_IMPRESE_REQUEST_TEMPLATE=
REGISTRO_IMPRESE_RESPONSE_ITEMS_PATH=
REGISTRO_IMPRESE_FIELD_DENOMINATION=
REGISTRO_IMPRESE_FIELD_LEGAL_NAME=
REGISTRO_IMPRESE_FIELD_COMUNE=
REGISTRO_IMPRESE_FIELD_VAT=
REGISTRO_IMPRESE_FIELD_ATECO_CODE=
REGISTRO_IMPRESE_FIELD_ATECO_TITLE=
REGISTRO_IMPRESE_FIELD_ADDRESS=
REGISTRO_IMPRESE_FIELD_CIVICO=
REGISTRO_IMPRESE_FIELD_CAP=
REGISTRO_IMPRESE_FIELD_PHONE=
REGISTRO_IMPRESE_FIELD_EMAIL=
REGISTRO_IMPRESE_FIELD_PEC=
REGISTRO_IMPRESE_FIELD_WEBSITE=
REGISTRO_IMPRESE_FIELD_STATUS=

# Albi: impostare solo dopo verifica della fonte pubblica/API specifica
F1_ALBO_GEOMETRI_SOURCE_URL=
F1_ALBO_ARCHITETTI_SOURCE_URL=
F1_ALBO_INGEGNERI_SOURCE_URL=
F1_ALBO_COMMERCIALISTI_SOURCE_URL=
F1_ALBO_AVVOCATI_SOURCE_URL=
F1_ALBO_CONSULENTI_LAVORO_SOURCE_URL=
F1_ALBO_SANITARI_SOURCE_URL=
