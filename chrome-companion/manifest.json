{
  "manifest_version": 3,
  "name": "F1 Chrome Companion",
  "version": "1.0.0",
  "description": "Esegue in coda le Google Dork richieste da F1 Acquisition Engine e salva i risultati pubblici su Supabase.",
  "permissions": ["storage", "tabs", "scripting", "alarms", "notifications"],
  "host_permissions": [
    "https://nqnmlsmeiynxbdojeyjt.supabase.co/*",
    "https://www.google.com/*",
    "https://www.google.it/*",
    "https://*.google.com/*",
    "https://*.google.it/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://josephsocialmedia2-spec.github.io/launcher-dashboard/*"],
      "js": ["f1-session-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "F1 Chrome Companion"
  }
}
